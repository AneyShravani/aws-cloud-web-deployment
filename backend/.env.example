# ============================================================
# backend/.env  (backend environment variables)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env to git.
# ============================================================
PORT=5000
MONGO_URI=mongodb://localhost:27017/ai-lab-maintenance
JWT_SECRET=change-me-to-a-long-random-string
# Days before end-date when an assignment counts as "nearing expiry"
NEARING_EXPIRY_DAYS=7
# SMTP settings for sending Admin credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@toriiminds.com
